# Long-running weather ingestion worker: fetches Open-Meteo data on a schedule and writes it with
# the weather_ingest role only (constitution Principle III / spec 002 FR-001).

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/db/package.json packages/db/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/ingest/package.json packages/ingest/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/web/package.json packages/web/package.json
RUN npm ci

# Prisma Client is generated (not published in node_modules) — needs the schema present, then
# emits plain TypeScript into packages/db/src/generated (see prisma.config.ts). No Rust query
# engine to fetch (Prisma 7 dropped it), so nothing platform-specific about this step.
COPY prisma.config.ts ./
COPY packages/db/prisma ./packages/db/prisma
RUN npx prisma generate --config prisma.config.ts

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY tsconfig.base.json ./
COPY packages/db ./packages/db
COPY packages/ingest ./packages/ingest
COPY --from=deps /app/packages/db/src/generated ./packages/db/src/generated
RUN chown -R node:node /app
USER node

CMD ["npx", "tsx", "packages/ingest/src/index.ts"]
