{
  "name": "@weather-demo/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts",
    "./test-utils": "./src/test-utils.ts",
    "./test-helpers": "./src/repositories/test-helpers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:dev": "prisma migrate dev --config ../../prisma.config.ts",
    "db:roles": "tsx src/apply-roles.ts",
    "db:seed": "tsx src/seed.ts",
    "db:smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2"
  }
}
