# Copy to .env and adjust before running `docker compose up --build`.
# None of these are real credentials — replace them for anything beyond local/demo use.

# --- Postgres server ---
POSTGRES_USER=weather_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=weather_demo
# Host port the compose stack's Postgres is published on (container always listens on 5432).
# Defaults to 55432 to avoid colliding with a Postgres already running on your machine.
POSTGRES_HOST_PORT=55432

# --- Least-privilege application roles (created by the `migrate` service; see
# packages/db/roles.sql and packages/db/src/apply-roles.ts) ---
WEATHER_INGEST_PASSWORD=change-me-ingest
WEATHER_API_PASSWORD=change-me-api

# --- Full connection strings, for running packages/db scripts outside Docker (e.g. `npm run
# db:migrate` against a local Postgres). Inside docker-compose these are constructed
# automatically from the values above; you do not need to set them there. ---
DATABASE_URL_OWNER=postgresql://weather_owner:change-me-owner@localhost:5432/weather_demo
DATABASE_URL_INGEST=postgresql://weather_ingest:change-me-ingest@localhost:5432/weather_demo
DATABASE_URL_API=postgresql://weather_api:change-me-api@localhost:5432/weather_demo
